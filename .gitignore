# ============================================
# BEOIS - Git Ignore
# ============================================

# Environment / Secrets
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Django
*.log
local_settings.py

# SQLite - BEOIS uses PostgreSQL
db.sqlite3
db.sqlite3-journal

# User uploaded files
media/

# Static build output
staticfiles/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Node / Next.js - for upcoming frontend
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
*.tmp
*.temp
~*
# Student uploaded documents
students/documents/

# Runtime partner document uploads
partners/documents/