# ============================================================
# BEOIS BACKEND - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env on the production server.
# NEVER commit the real .env file.

# Django
DJANGO_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
DJANGO_DEBUG=False

# Replace with the actual production domain(s)
DJANGO_ALLOWED_HOSTS=beois.example.com

# Frontend origin(s)
DJANGO_CORS_ALLOWED_ORIGINS=https://beois.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://beois.example.com

# HTTPS / cookies
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# HSTS
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Keep False until the production HTTPS/domain configuration
# has been proven stable.
DJANGO_SECURE_HSTS_PRELOAD=False

# Use True only when HTTPS is terminated by a trusted
# reverse proxy such as Nginx.
DJANGO_TRUST_PROXY_SSL_HEADER=True

# PostgreSQL
DB_NAME=beois_production
DB_USER=beois_production_user
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
